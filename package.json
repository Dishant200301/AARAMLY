{
  "name": "aaramly-ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Monorepo for AARAMLY Platform",
  "workspaces": [
    "client",
    "server",
    "admin"
  ],
  "scripts": {
    "dev:client": "node api.js && npm --prefix client run dev",
    "dev:server": "node api.js && npm --prefix server run dev",
    "dev:admin": "node api.js && npm --prefix admin run dev",
    "db:init": "npm --prefix server run db:init",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:admin": "npm --prefix admin run build"
  }
}
